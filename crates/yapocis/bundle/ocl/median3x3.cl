/* Kernel to compute 3x3 median filter on a 2D image */

static inline float median9(float *a, int n) {
    float l,h;
    bool lt;
            lt = a[1] < a[0];
            l = lt ? a[1] : a[0];
            h = lt ? a[0] : a[1];
            a[0] = l;
            a[1] = h;
            lt = a[2] < a[0];
            l = lt ? a[2] : a[0];
            h = lt ? a[0] : a[2];
            a[0] = l;
            a[2] = h;
            lt = a[3] < a[0];
            l = lt ? a[3] : a[0];
            h = lt ? a[0] : a[3];
            a[0] = l;
            a[3] = h;
            lt = a[4] < a[0];
            l = lt ? a[4] : a[0];
            h = lt ? a[0] : a[4];
            a[0] = l;
            a[4] = h;
            lt = a[5] < a[0];
            l = lt ? a[5] : a[0];
            h = lt ? a[0] : a[5];
            a[0] = l;
            a[5] = h;
            lt = a[6] < a[0];
            l = lt ? a[6] : a[0];
            h = lt ? a[0] : a[6];
            a[0] = l;
            a[6] = h;
            lt = a[7] < a[0];
            l = lt ? a[7] : a[0];
            h = lt ? a[0] : a[7];
            a[0] = l;
            a[7] = h;
            lt = a[8] < a[0];
            l = lt ? a[8] : a[0];
            h = lt ? a[0] : a[8];
            a[0] = l;
            a[8] = h;
            lt = a[2] < a[1];
            l = lt ? a[2] : a[1];
            h = lt ? a[1] : a[2];
            a[1] = l;
            a[2] = h;
            lt = a[3] < a[1];
            l = lt ? a[3] : a[1];
            h = lt ? a[1] : a[3];
            a[1] = l;
            a[3] = h;
            lt = a[4] < a[1];
            l = lt ? a[4] : a[1];
            h = lt ? a[1] : a[4];
            a[1] = l;
            a[4] = h;
            lt = a[5] < a[1];
            l = lt ? a[5] : a[1];
            h = lt ? a[1] : a[5];
            a[1] = l;
            a[5] = h;
            lt = a[6] < a[1];
            l = lt ? a[6] : a[1];
            h = lt ? a[1] : a[6];
            a[1] = l;
            a[6] = h;
            lt = a[7] < a[1];
            l = lt ? a[7] : a[1];
            h = lt ? a[1] : a[7];
            a[1] = l;
            a[7] = h;
            lt = a[8] < a[1];
            l = lt ? a[8] : a[1];
            h = lt ? a[1] : a[8];
            a[1] = l;
            a[8] = h;
            lt = a[3] < a[2];
            l = lt ? a[3] : a[2];
            h = lt ? a[2] : a[3];
            a[2] = l;
            a[3] = h;
            lt = a[4] < a[2];
            l = lt ? a[4] : a[2];
            h = lt ? a[2] : a[4];
            a[2] = l;
            a[4] = h;
            lt = a[5] < a[2];
            l = lt ? a[5] : a[2];
            h = lt ? a[2] : a[5];
            a[2] = l;
            a[5] = h;
            lt = a[6] < a[2];
            l = lt ? a[6] : a[2];
            h = lt ? a[2] : a[6];
            a[2] = l;
            a[6] = h;
            lt = a[7] < a[2];
            l = lt ? a[7] : a[2];
            h = lt ? a[2] : a[7];
            a[2] = l;
            a[7] = h;
            lt = a[8] < a[2];
            l = lt ? a[8] : a[2];
            h = lt ? a[2] : a[8];
            a[2] = l;
            a[8] = h;
            lt = a[4] < a[3];
            l = lt ? a[4] : a[3];
            h = lt ? a[3] : a[4];
            a[3] = l;
            a[4] = h;
            lt = a[5] < a[3];
            l = lt ? a[5] : a[3];
            h = lt ? a[3] : a[5];
            a[3] = l;
            a[5] = h;
            lt = a[6] < a[3];
            l = lt ? a[6] : a[3];
            h = lt ? a[3] : a[6];
            a[3] = l;
            a[6] = h;
            lt = a[7] < a[3];
            l = lt ? a[7] : a[3];
            h = lt ? a[3] : a[7];
            a[3] = l;
            a[7] = h;
            lt = a[8] < a[3];
            l = lt ? a[8] : a[3];
            h = lt ? a[3] : a[8];
            a[3] = l;
            a[8] = h;
            lt = a[5] < a[4];
            l = lt ? a[5] : a[4];
            h = lt ? a[4] : a[5];
            a[4] = l;
            a[5] = h;
            lt = a[6] < a[4];
            l = lt ? a[6] : a[4];
            h = lt ? a[4] : a[6];
            a[4] = l;
            a[6] = h;
            lt = a[7] < a[4];
            l = lt ? a[7] : a[4];
            h = lt ? a[4] : a[7];
            a[4] = l;
            a[7] = h;
            lt = a[8] < a[4];
            l = lt ? a[8] : a[4];
            h = lt ? a[4] : a[8];
            a[4] = l;
            a[8] = h;
    return a[n/2];
}


__kernel
void median3x3(int width, int height, __global float* a, __global float* ret )
{
    float aa[9];
    size_t i;
    float m;
    size_t left = height + 1;
    size_t right = width - left;
    int h = height;
    i = get_global_id(0);
    m = a[i];
    if ((i >= left) &&  (i < right)) {
		aa[0] =  a[(i-h)-1];
		aa[1] =  a[i-h];
		aa[2] =  a[(i-h)+1];
		aa[3] =  a[i-1];
		aa[4] =  a[i];
		aa[5] =  a[i+1];
		aa[6] =  a[(i+h)-1];
		aa[7] =  a[i+h];
		aa[8] =  a[(i+h)+1];
	    m = median9(&aa[0], 9);
    }
    ret[i] = m;
    return;
}